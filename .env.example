TELEGRAM_BOT_TOKEN=
LOG_LEVEL=INFO
WHISPER_MODEL=base
MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
LLAMA_CONTEXT=4096
LLAMA_BATCH=64
LLAMA_UBATCH=32
LLAMA_PARALLEL_SLOTS=1
LLAMA_GPU_LAYERS=999
CUDA_VERSION=12.8.1
UBUNTU_VERSION=24.04
CUDA_DOCKER_ARCH=default
UPSTREAM_TIMEOUT=180

# Never commit real secrets. Generate two DIFFERENT random values, >=16 chars.
CRM_API_KEY=
MOCK_CRM_VIEW_PASSWORD=
# JSON mapping of authorized Telegram user IDs -> CRM employee phone numbers.
# Example: CRM_AGENT_BINDINGS={"123456789":"79991234567"}
CRM_AGENT_BINDINGS={}
# For bot-only with a real CRM, use an HTTPS URL ending /client/add-note.
# Default Compose URL is internal mock CRM: http://mock-crm:8000/client/add-note
CRM_URL=
# Mock's web UI is bound to 127.0.0.1 only.
MOCK_CRM_PORT=8765
