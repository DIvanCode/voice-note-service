TELEGRAM_BOT_TOKEN=
LOG_LEVEL=INFO
WHISPER_MODEL=small
MODEL_FILE=Qwen3-0.6B-Q8_0.gguf
LLAMA_CONTEXT=2048
LLAMA_BATCH=32
LLAMA_UBATCH=16
LLAMA_PARALLEL_SLOTS=1
LLAMA_GPU_LAYERS=999
UPSTREAM_TIMEOUT=180

# Configure two different secrets for the mock CRM (never commit .env).
CRM_API_KEY=
MOCK_CRM_VIEW_PASSWORD=
# Telegram user ID -> CRM employee phone (JSON object).
CRM_AGENT_BINDINGS={}
# External CRM requires HTTPS; empty uses the internal mock on Compose.
CRM_URL=
MOCK_CRM_PORT=8765
